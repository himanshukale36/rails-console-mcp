{
  "name": "rails-console-mcp",
  "version": "1.0.2",
  "description": "Warm persistent Rails console sessions over MCP",
  "type": "module",
  "bin": {
    "rails-console-mcp": "src/index.js"
  },
  "files": [
    "src/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "prepack": "npm test",
    "start": "node src/index.js",
    "test": "node --test test/*.test.js",
    "smoke": "node scripts/smoke.js",
    "postinstall": "node -e \"const fs=require('fs'),p=require('path'),d='node_modules/node-pty/prebuilds';if(fs.existsSync(d))for(const s of fs.readdirSync(d)){const h=p.join(d,s,'spawn-helper');if(fs.existsSync(h)){try{fs.chmodSync(h,0o755)}catch{}}}\""
  },
  "keywords": [
    "mcp",
    "rails",
    "model-context-protocol",
    "ai",
    "claude",
    "cursor"
  ],
  "author": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/himanshukale36/rails-console-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/himanshukale36/rails-console-mcp/issues"
  },
  "homepage": "https://github.com/himanshukale36/rails-console-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "node-pty": "^1.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
